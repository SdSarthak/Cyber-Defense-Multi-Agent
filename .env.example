# ─── Google AI Studio ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
# Check https://ai.google.dev/gemini-api/docs/deprecations — Google retires models on a
# schedule, and both of these are plain configuration.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# Process-wide ceiling on Gemini chat calls (shared by every agent). Keep it under your
# quota's requests-per-minute. 0 disables the limiter.
LLM_REQUESTS_PER_MINUTE=10
LLM_MAX_RETRIES=2

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cyberdefense
POSTGRES_USER=cyberdefense
POSTGRES_PASSWORD=strongpassword123
# The API applies Alembic migrations at startup. Alembic is the only schema source.
RUN_MIGRATIONS_ON_STARTUP=true

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elastic123
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_LOG_INDEX=cyberdefense-logs

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_THREATS=threat_intel
CHROMA_COLLECTION_VULNS=vulnerability_kb
CHROMA_COLLECTION_COMPLIANCE=compliance_policies
# Retrieval is an enhancement, not a hard dependency — set false to skip Chroma entirely.
RAG_ENABLED=true

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# JWT signing key, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty (or set to a known default) the API uses a random per-process key, so
# tokens stop working on every restart.
API_SECRET_KEY=
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
# The /ws socket accepts privileged override commands, so it authenticates the same
# JWT the REST API does. Turn off only for a local, single-user demo.
WEBSOCKET_AUTH_REQUIRED=true
# Per-user cap on state-changing API calls (most of them start LLM work).
API_WRITE_RATE_LIMIT_PER_MINUTE=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# ─── Accounts ─────────────────────────────────────────────────────────────────
# REQUIRED. An account whose password is empty, shorter than 8 characters or one of
# the demo values is disabled at startup. Replace with a real user store before any
# deployment reachable off-host.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=
# true restores the old demo logins (admin/admin123, analyst/analyst123) and a fixed
# signing key. Local, single-user experiments only.
ALLOW_INSECURE_DEFAULTS=false

# ─── Agents ───────────────────────────────────────────────────────────────────
AGENT_TIMEOUT_SECONDS=120
# Covers routing + every dispatched agent + a follow-up report.
SUPERVISOR_TIMEOUT_SECONDS=420
LOG_ANALYSIS_BATCH_SIZE=100
# always | on_hits (LLM only for batches with suspicious signatures) | off (regex only)
LOG_ANALYSIS_LLM_MODE=always

# ─── Vulnerability scanning ───────────────────────────────────────────────────
# Scheduled scans run only when targets or CVEs are listed.
VULN_SCAN_INTERVAL=3600
VULN_SCAN_TARGETS=
VULN_WATCHLIST_CVES=
# When set, the port probe only touches addresses inside these CIDRs. Loopback,
# link-local (incl. cloud metadata), multicast and reserved space are always refused.
SCAN_ALLOWED_NETWORKS=
# Free key from https://nvd.nist.gov/developers/request-an-api-key raises NVD's limit
# from 5 to 50 requests per 30 seconds.
NVD_API_KEY=
NVD_CACHE_TTL_SECONDS=86400

# ─── Escalation & response ────────────────────────────────────────────────────
ENABLE_PERSISTENCE=true
ESCALATION_AUTO_RESPONSE=true
ESCALATION_COOLDOWN_SECONDS=60
# A lower threat level only replaces a higher one after it has stood this long.
THREAT_LEVEL_HOLD_SECONDS=900
# simulate: record actions as "simulated" (nothing runs). webhook: POST each approved
# action to CONTAINMENT_WEBHOOK_URL (your SOAR / firewall automation).
CONTAINMENT_MODE=simulate
CONTAINMENT_WEBHOOK_URL=
CONTAINMENT_REQUIRE_APPROVAL=true

# ─── Simulation ────────────────────────────────────────────────────────────────
SIMULATION_MODE=true
# Logs per second produced by `python -m simulation.engine`.
SIMULATION_LOG_RATE=1
SIMULATION_ATTACK_PROBABILITY=0.05
# The API analyses the queued logs: up to SIMULATION_BATCH_SIZE per run, one run (at
# most one LLM call) every SIMULATION_ANALYSIS_INTERVAL_SECONDS.
SIMULATION_CONSUMER_ENABLED=true
SIMULATION_BATCH_SIZE=100
SIMULATION_ANALYSIS_INTERVAL_SECONDS=60
# Queued logs older than this are dropped and counted (simulation_logs_dropped_total).
SIMULATION_MAX_LAG_SECONDS=600
# true: injected attack scenarios also publish an escalation directly. false (default):
# incidents only appear when the detection agents catch the attack themselves.
SIMULATION_INJECT_ESCALATIONS=false
